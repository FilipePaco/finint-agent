# Local secrets only. Never commit a populated .env file.

# LLM (Gemini). Use a paid-tier or Vertex AI key: free-tier prompts may be used for training.
GOOGLE_API_KEY=

# Adverse-media search (optional; offline fixtures are the default)
TAVILY_API_KEY=

# Observability (optional; everything runs without it)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Overrides (examples)
# FININT_SEED=42
# FININT_INVESTIGATOR__MODEL=gemini-3.5-flash-lite
# FININT_REVIEWER__MODEL=gemini-3.5-flash
# FININT_MEDIA__MODEL=gemini-3.5-flash-lite
